NETWORK=mainnet
CONTRACT_ID=deadswitch.thalderg.near
OWNER_ID=thalderg.near
OPERATOR_ACCOUNT_ID=checkin.thalderg.near
# The operator's private key (ed25519:...). Paste it yourself; never commit or print it.
OPERATOR_PRIVATE_KEY=
# Email via Resend (https://resend.com). EMAIL_FROM like: Deadswitch <reminders@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=
# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=http://localhost:8787
SITE_URL=http://localhost:5173
# NEAR RPC endpoints, tried in order (comma-separated). Empty = a built-in list of public endpoints.
RPC_URLS=
TOKENS=nep141:wrap.near
# For the demo, e.g. 300,120 (seconds before the deadline). Empty = the real schedule.
DEMO_REMINDER_OFFSETS_SECONDS=
# true = log instead of sending transactions. Set to false only when you decide to go live.
DRY_RUN=true
